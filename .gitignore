# 依赖
node_modules/
desktop/node_modules/

# 用户数据：库、预览图、备份、配置（含接口 token，绝对不能进仓库）
data/

# 打包产物与运行时（安装包走 Release，不进仓库）
dist/
desktop/runtime/

# 旧版前端存档
backup/

# 改代码时留的备份
*.bak
*.bak-*
*.orig

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
tmp/
tmp-*

# 编辑器
.vscode/
.idea/

# 内部文档：给本机工作用，不对外
HANDOFF.md
DEVLOG.md

# 截图：界面里的预览图可能含成人向内容，不进仓库。要放之前先重截干净的。
docs/*.png
!docs/shot-*.png
!docs/icon-*.png
publish/img/*.png
!publish/img/icon.png

# 落地页：部署用，不是源码。图片含界面预览，不进仓库。
publish/
